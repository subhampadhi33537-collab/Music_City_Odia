# ==============================================================================
# Frontend Specific Git Ignore
# ==============================================================================

# Environment files
.env
.env.*
.env*.local
!.env.example

# Dependencies
node_modules/

# Production build outputs
dist/
dist-ssr/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.local
