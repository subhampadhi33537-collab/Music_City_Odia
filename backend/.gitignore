# ==============================================================================
# Backend Specific Git Ignore
# ==============================================================================

# Environment files & secrets
.env
.env.*
*.env
!.env.example
service_account.json
*credentials*.json
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/

# Build & packaging
build/
dist/
*.egg-info/

# Tests & caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local database files
data/
*.db
*.sqlite
*.sqlite3

# Uploaded static media (retain directories with .gitkeep)
static/audio/*
!static/audio/.gitkeep
static/covers/*
!static/covers/.gitkeep

# Logs
*.log

# OS & Editors
.DS_Store
Thumbs.db
.idea/
.vscode/
